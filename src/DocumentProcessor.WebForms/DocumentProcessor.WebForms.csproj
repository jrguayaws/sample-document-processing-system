<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>
  <!-- Legacy WebForms code-behind and designer files superseded by Blazor components in Components/ -->
  <ItemGroup>
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="ErrorPage.aspx.cs" />
    <Compile Remove="ErrorPage.aspx.designer.cs" />
    <Compile Remove="Controls\DocumentList.ascx.cs" />
    <Compile Remove="Controls\DocumentList.ascx.designer.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.9" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.11" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
